# Build output
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
*.user
*.suo
.vs/

# Release / publish artefacts (produced by scripts/publish.ps1; not source)
# Anchored to the repo root so they never match nested source folders (Windows core.ignorecase).
/publish/
*.zip
*.zip.sha256

# Test results
[Tt]est[Rr]esults/
*.trx
coverage*.xml
coverage*.json

# Runtime artefacts (user data / logs must never be committed).
# Anchored to the repo root (leading /) so they do NOT match nested source folders such as
# src/KikuCaption.Core/Models on case-insensitive Windows filesystems.
/logs/
/Meetings/
tools/ffmpeg/*
!tools/ffmpeg/.gitkeep

# Local secrets / user-specific config (PROJECT.md 5.6, 13)
appsettings.*.local.json
secrets.json
*.secret

# Python worker environment + downloaded models (user/runtime data, not source).
# NOTE: /models/ is anchored to the repo root — an unanchored "models/" would wrongly match
# source folders like src/KikuCaption.Core/Models on case-insensitive Windows.
python/whisper_worker/.venv/
/models/
__pycache__/
*.py[cod]
.pytest_cache/

# FFmpeg binaries (downloaded to tools/ffmpeg; not committed — keep .gitkeep only)
tools/ffmpeg/*.exe
tools/ffmpeg/*.dll
