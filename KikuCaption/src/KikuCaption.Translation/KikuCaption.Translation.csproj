<Project Sdk="Microsoft.NET.Sdk">

  <!-- Company OpenAI-compatible translation adapter, bounded queue, and DPAPI secret store.
       Depends only on Core (no WPF, no Storage) so it stays independently testable; the App
       composes it with Storage. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>KikuCaption.Translation</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KikuCaption.Core\KikuCaption.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

</Project>
