{
  "Speech": {
    "Engine": "Whisper",
    "Model": "small",
    "ComputeType": "int8",
    "Language": "ja",
    "BeamSize": 2,
    "SilenceFinalMs": 700,
    "StableRepeatCount": 2,
    "MaxSentenceSeconds": 12,
    "MaxWaitSeconds": 20,
    "Contexts": {
      "ja": {
        "InitialPrompt": "技術会議の字幕。専門用語や英語の技術用語を含みます。",
        "Hotwords": [
          "Azure",
          "OpenAI",
          "Chat Completions API",
          "Responses API",
          "Embedding API",
          "Web検索",
          "ファイル検索"
        ]
      },
      "zh": {
        "InitialPrompt": "这是一场包含中文和英文技术术语的技术会议。",
        "Hotwords": [
          "Azure",
          "OpenAI",
          "Chat Completions API",
          "Responses API",
          "Embedding API"
        ]
      }
    }
  },
  "Translation": {
    "Enabled": false,
    "Endpoint": "",
    "Model": "",
    "ApiVersion": "",
    "AuthenticationMode": "Bearer",
    "HeaderName": "Authorization",
    "Proxy": "",
    "TimeoutSeconds": 30,
    "MaxRetries": 3,
    "MaxQueueLength": 100,
    "MaxConcurrency": 1,
    "MaxInputCharacters": 4000,
    "SourceLanguage": "ja",
    "TargetLanguage": "zh"
  },
  "Recording": {
    "FrameRate": 15,
    "PreferredEncoder": "h264_qsv",
    "FallbackEncoder": "libx264",
    "AudioSampleRate": 48000
  },
  "Subtitle": {
    "FontSize": 26,
    "Opacity": 0.85,
    "MaxLines": 4,
    "ClickThrough": false
  },
  "Storage": {
    "OutputDirectory": "Meetings",
    "MinimumFreeSpaceGb": 2,
    "LogRetentionDays": 14
  }
}
