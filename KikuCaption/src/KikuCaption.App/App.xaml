<Application x:Class="KikuCaption.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:KikuCaption.App.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/AppTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:InverseBooleanConverter x:Key="InverseBool" />
            <converters:NonEmptyToVisibilityConverter x:Key="NonEmptyToVisibility" />
            <converters:LanguageDisplayConverter x:Key="LanguageDisplay" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
