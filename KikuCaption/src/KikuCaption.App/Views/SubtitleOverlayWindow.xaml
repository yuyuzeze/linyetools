<Window x:Class="KikuCaption.App.Views.SubtitleOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KikuCaption 字幕"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" ShowActivated="False">
    <Border CornerRadius="8" Padding="16,12" MinWidth="380" MaxWidth="900">
        <Border.Background>
            <SolidColorBrush Color="Black" Opacity="{Binding BackgroundOpacity}" />
        </Border.Background>
        <StackPanel>
            <ItemsControl ItemsSource="{Binding Lines}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,2,0,2">
                            <!-- Original (final: bright) -->
                            <TextBlock Text="{Binding Original}" TextWrapping="Wrap"
                                       Foreground="#F5F5F5"
                                       FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <!-- Chinese translation (Milestone 6), filled in place when it returns -->
                            <TextBlock Text="{Binding Translation}" TextWrapping="Wrap"
                                       Foreground="#6FC3FF" Margin="0,1,0,0"
                                       FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Visibility="{Binding HasTranslation, Converter={StaticResource BoolToVisibility}}" />
                            <!-- Low-key "translating" hint while the request is in flight -->
                            <TextBlock Text="翻译中…" Foreground="#7F9FB0" FontSize="12" Margin="0,1,0,0"
                                       Visibility="{Binding IsTranslating, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Current partial (dim) -->
            <TextBlock Text="{Binding PartialText}" TextWrapping="Wrap"
                       Foreground="#9E9E9E" Margin="0,2,0,0"
                       FontSize="{Binding FontSize}"
                       Visibility="{Binding HasPartial, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </Border>
</Window>
