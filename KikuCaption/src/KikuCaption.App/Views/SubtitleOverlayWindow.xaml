<Window x:Class="KikuCaption.App.Views.SubtitleOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:KikuCaption.App.Localization"
        Title="KikuCaption 字幕"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="{Binding Topmost}" ShowInTaskbar="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" ShowActivated="False">
    <Border CornerRadius="8" Padding="16,12" MinWidth="380" MaxWidth="900">
        <Border.Background>
            <SolidColorBrush Color="Black" Opacity="{Binding BackgroundOpacity}" />
        </Border.Background>
        <StackPanel>
            <ItemsControl ItemsSource="{Binding Lines}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,2,0,2">
                            <!-- Original (final: bright) -->
                            <TextBlock Text="{Binding Original}" TextWrapping="Wrap"
                                       Foreground="{Binding DataContext.OriginalColor, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontFamily="{Binding DataContext.FontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Visibility="{Binding DataContext.ShowOriginal, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                            <!-- Translation, filled in place when it returns (M6) -->
                            <TextBlock Text="{Binding Translation}" TextWrapping="Wrap"
                                       Foreground="{Binding DataContext.TranslationColor, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontFamily="{Binding DataContext.FontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Margin="0,1,0,0"
                                       FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=Window}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasTranslation}" Value="True" />
                                                    <Condition Binding="{Binding DataContext.ShowTranslation, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- Low-key "translating" hint while the request is in flight -->
                            <TextBlock Text="{loc:Loc Overlay.Translating}" Foreground="#7F9FB0" FontSize="12" Margin="0,1,0,0"
                                       Visibility="{Binding IsTranslating, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Current partial (dim) -->
            <TextBlock Text="{Binding PartialText}" TextWrapping="Wrap"
                       Foreground="{Binding OriginalColor}" Opacity="{Binding PartialOpacity}"
                       FontFamily="{Binding FontFamily}" Margin="0,2,0,0"
                       FontSize="{Binding FontSize}"
                       Visibility="{Binding HasPartial, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </Border>
</Window>
