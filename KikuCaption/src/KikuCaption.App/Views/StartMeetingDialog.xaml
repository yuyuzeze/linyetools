<Window x:Class="KikuCaption.App.Views.StartMeetingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:KikuCaption.App.Localization"
        Title="{loc:Loc StartDialog.Title}" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource WindowBrush}" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Loc StartDialog.Title}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,16"
                   Text="{loc:Loc StartDialog.Intro}" />

        <!-- Capture target (edits the draft only; the main view model is untouched until confirm) -->
        <StackPanel Grid.Row="2">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{loc:Loc StartDialog.CaptureTarget}" VerticalAlignment="Center" Width="88" />
                <ComboBox Width="140" SelectedValuePath="Tag" SelectedValue="{Binding CaptureType}">
                    <ComboBoxItem Content="{loc:Loc StartDialog.WholeScreen}" Tag="screen" />
                    <ComboBoxItem Content="{loc:Loc StartDialog.SpecificWindow}" Tag="window" />
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="88,10,0,0"
                        Visibility="{Binding IsWindowCapture, Converter={StaticResource BoolToVisibility}}">
                <ComboBox Width="280" ItemsSource="{Binding Windows}" SelectedItem="{Binding SelectedWindow}" />
                <Button Content="{loc:Loc StartDialog.RefreshWindows}" Command="{Binding RefreshWindowsCommand}" Margin="8,0,0,0" Padding="10,4" />
            </StackPanel>
        </StackPanel>

        <!-- Audio inputs (UI-R5A): edits the draft only; applied to the meeting on confirm -->
        <StackPanel Grid.Row="3" Margin="0,18,0,0">
            <TextBlock Text="{loc:Loc StartDialog.AudioSection}" FontWeight="SemiBold" Margin="0,0,0,6" />
            <CheckBox Content="{loc:Loc StartDialog.RecordSystemAudio}" IsChecked="{Binding RecordSystemAudio}" Margin="0,2" />
            <CheckBox Content="{loc:Loc StartDialog.RecordMicrophone}" IsChecked="{Binding RecordMicrophone}" Margin="0,2"
                      ToolTip="{loc:Loc StartDialog.MicTooltip}" />

            <StackPanel Margin="24,4,0,0" Visibility="{Binding RecordMicrophone, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Loc StartDialog.MicDevice}" VerticalAlignment="Center" Width="76" />
                    <ComboBox Width="240" ItemsSource="{Binding MicDevices}" DisplayMemberPath="Name"
                              SelectedValuePath="Id" SelectedValue="{Binding SelectedMicDeviceId}" />
                    <Button Content="{loc:Loc StartDialog.RefreshDevices}" Command="{Binding RefreshMicDevicesCommand}" Margin="8,0,0,0" Padding="10,4" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="{loc:Loc StartDialog.InputLevel}" VerticalAlignment="Center" Width="76" />
                    <ProgressBar Width="240" Height="12" Minimum="0" Maximum="1" Value="{Binding InputLevel, Mode=OneWay}" />
                </StackPanel>
                <TextBlock Text="{loc:Loc StartDialog.MicTooltip}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Foreground="{StaticResource MutedBrush}" FontSize="11" />
                <TextBlock Text="{loc:Loc StartDialog.MicUnavailable}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#C0392B"
                           Visibility="{Binding MicrophoneUnavailable, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <TextBlock Text="{loc:Loc StartDialog.NoAudioInput}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#C0392B"
                       Visibility="{Binding ShowNoInputWarning, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,18,0,0">
            <TextBlock Text="{loc:Loc StartDialog.OutputLocation}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding OutputRoot}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                       FontFamily="Consolas" FontSize="12" Margin="0,2,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <!-- IsCancel makes Esc (and window-close) resolve to cancel without touching the draft. -->
                <Button Content="{loc:Loc StartDialog.Cancel}" MinWidth="88" IsCancel="True" />
                <Button Content="{loc:Loc StartDialog.Start}" Style="{StaticResource PrimaryButton}" MinWidth="110" Margin="10,0,0,0"
                        Click="Start_Click" IsDefault="True" IsEnabled="{Binding CanStart}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
