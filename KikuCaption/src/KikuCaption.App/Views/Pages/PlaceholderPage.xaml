<UserControl x:Class="KikuCaption.App.Views.Pages.PlaceholderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="24"
            HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
        <StackPanel>
            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,10,0,0"
                       Foreground="{StaticResource MutedBrush}" />
        </StackPanel>
    </Border>
</UserControl>
