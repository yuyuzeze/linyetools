<UserControl x:Class="KikuCaption.App.Views.Pages.EnvironmentPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:KikuCaption.App.Localization">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: title + aggregated health banner. -->
        <Border Grid.Row="0" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Loc Env.Title}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Background="{Binding HealthColor}" CornerRadius="9" Width="14" Height="14"
                            VerticalAlignment="Center" Margin="14,0,6,0" />
                    <TextBlock Text="{Binding HealthText}" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding LastCheckedText}" VerticalAlignment="Center" Margin="14,0,0,0"
                               Foreground="{StaticResource MutedBrush}" FontSize="12" />
                    <ProgressBar IsIndeterminate="True" Width="90" Height="4" Margin="14,0,0,0" VerticalAlignment="Center"
                                 Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <TextBlock Text="{Binding OverallMessage}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- Per-dependency rows. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                                Padding="12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="14" Height="14" CornerRadius="7"
                                        VerticalAlignment="Top" Margin="0,3,10,0"
                                        Background="{Binding StatusColor}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                                    <TextBlock Text="{Binding DetectedVersion}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"
                                               Visibility="{Binding HasDetectedVersion, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding ResolvedPath}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                                               Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"
                                               Visibility="{Binding HasResolvedPath, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding Remediation}" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0"
                                               Visibility="{Binding HasRemediation, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                                <Border Grid.Column="2" Background="{Binding StatusColor}" CornerRadius="4" Padding="8,2" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="12" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Actions: re-check / open settings / copy sanitized diagnostics. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="{loc:Loc Env.Recheck}" Padding="16,6" MinWidth="110"
                    Command="{Binding CheckCommand}"
                    IsEnabled="{Binding IsChecking, Converter={StaticResource InverseBool}}" />
            <Button Content="{loc:Loc Env.OpenSettings}" Padding="16,6" Margin="8,0,0,0"
                    Command="{Binding DataContext.GoSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Button Content="{loc:Loc Env.CopyDiagnostics}" Padding="16,6" Margin="8,0,0,0"
                    Command="{Binding CopyDiagnosticsCommand}"
                    IsEnabled="{Binding HasChecked}" />
        </StackPanel>
    </Grid>
</UserControl>
