<UserControl x:Class="KikuCaption.App.Views.Pages.AudioPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:KikuCaption.App.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="{loc:Loc Audio.Title}" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Loc Audio.Intro}"
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,14" />

            <!-- System audio capture -->
            <GroupBox Header="{loc:Loc Audio.CaptureHeader}" Padding="10" DataContext="{Binding Capture}">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"
                               Text="{loc:Loc Audio.CaptureIntro}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{loc:Loc Audio.StartCapture}" Click="StartCapture_Click" MinWidth="110"
                                IsEnabled="{Binding IsCapturing, Converter={StaticResource InverseBool}}" />
                        <Button Content="{loc:Loc Audio.Stop}" Command="{Binding StopCommand}" MinWidth="80" Margin="8,0,0,0"
                                IsEnabled="{Binding IsCapturing}" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding OutputPath}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </GroupBox>

            <!-- Local speech recognition -->
            <GroupBox Header="{loc:Loc Audio.RecognizeHeader}" Margin="0,12,0,0" Padding="10" DataContext="{Binding Speech}">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"
                               Text="{loc:Loc Audio.RecognizeIntro}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Loc Audio.RecognitionLanguage}" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                                  Width="90" Margin="6,0,0,0" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{loc:LangName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="{loc:Loc Audio.RecognizeWav}" Click="RecognizeWav_Click" MinWidth="130" Margin="12,0,0,0"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        <ProgressBar IsIndeterminate="True" Width="120" Height="6" Margin="12,0,0,0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Results}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontFamily="Consolas" Margin="0,1,0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
