<UserControl x:Class="KikuCaption.App.Views.Pages.DictionaryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:KikuCaption.App.Localization">
    <UserControl.Resources>
        <!-- Read-only editor fields (built-in dictionaries): muted + a tooltip that explains how to
             edit, so a built-in never looks editable-but-fails-to-save. -->
        <Style x:Key="DictEditBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Style.Triggers>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Background" Value="{StaticResource CardBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                    <Setter Property="ToolTip" Value="{loc:Loc Dict.BuiltInReadOnlyHint}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Loc Dict.Title}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" Text="{loc:Loc Dict.Disclaimer}" TextWrapping="Wrap" Margin="0,0,0,10"
                   Foreground="{StaticResource MutedBrush}" FontSize="12" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ==================== Left: filter + list ==================== -->
            <DockPanel Grid.Column="0" Margin="0,0,14,0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="{loc:Loc Dict.LanguageFilter}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Width="140" ItemsSource="{Binding FilterLanguages}" SelectedItem="{Binding FilterLanguage}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{loc:LangName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="{loc:Loc Dict.New}" Command="{Binding NewCommand}" />
                    <Button Content="{loc:Loc Dict.Duplicate}" Command="{Binding DuplicateCommand}" Margin="6,0,0,0"
                            IsEnabled="{Binding HasSelection}" />
                    <Button Content="{loc:Loc Dict.Delete}" Command="{Binding DeleteCommand}" Margin="6,0,0,0"
                            IsEnabled="{Binding IsEditable}" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                         BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- Name on its own line (single-line ellipsis, full name via tooltip);
                                 the Active/Built-in badges sit on a second line so a narrow window
                                 never truncates a badge or forces a horizontal scrollbar. -->
                            <StackPanel Margin="2,4" ToolTip="{Binding DisplayName}">
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <Border Background="{StaticResource AccentBrush}" CornerRadius="3" Padding="5,1" Margin="0,0,4,0"
                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{loc:Loc Dict.ActiveMarker}" FontSize="10" Foreground="White" />
                                    </Border>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="5,1"
                                            Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{loc:Loc Dict.BuiltInMarker}" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- ==================== Right: editor ==================== -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsEditorVisible, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Margin="2,0,4,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Dict.Name}" VerticalAlignment="Center" Margin="0,6" />
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,6" MaxLength="60" Style="{StaticResource DictEditBox}"
                                 IsReadOnly="{Binding IsEditable, Converter={StaticResource InverseBool}}"
                                 Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Dict.Language}" VerticalAlignment="Center" Margin="0,6" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EditLanguage, Converter={StaticResource LanguageDisplay}}"
                                   VerticalAlignment="Center" Margin="0,6" Foreground="{StaticResource MutedBrush}" />
                    </Grid>

                    <TextBlock Text="{loc:Loc Dict.InitialPrompt}" Margin="0,8,0,2" />
                    <TextBox Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Style="{StaticResource DictEditBox}"
                             IsReadOnly="{Binding IsEditable, Converter={StaticResource InverseBool}}"
                             Text="{Binding EditInitialPrompt, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{Binding PromptCharText}" HorizontalAlignment="Right" Margin="0,2,0,0"
                               Foreground="{StaticResource MutedBrush}" FontSize="11" />

                    <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                        <TextBlock Text="{loc:Loc Dict.Hotwords}" />
                        <TextBlock Text="{loc:Loc Dict.HotwordsHint}" Margin="8,0,0,0" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBox Height="180" TextWrapping="NoWrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" Style="{StaticResource DictEditBox}"
                             IsReadOnly="{Binding IsEditable, Converter={StaticResource InverseBool}}"
                             Text="{Binding EditHotwords, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                        <TextBlock Text="{Binding HotwordCountText}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                        <TextBlock Text="{Binding HotwordCharText}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="14,0,0,0" />
                    </StackPanel>

                    <TextBlock Text="{Binding ValidationError}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#C0392B"
                               Visibility="{Binding ValidationError, Converter={StaticResource NonEmptyToVisibility}}" />

                    <TextBlock Text="{loc:Loc Dict.LocalStorageNote}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Foreground="{StaticResource MutedBrush}" FontSize="11" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="{loc:Loc Dict.Save}" Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" />
                        <Button Content="{loc:Loc Dict.SetActive}" Command="{Binding SetActiveCommand}" Margin="8,0,0,0"
                                IsEnabled="{Binding HasSelection}" />
                        <Button Content="{loc:Loc Dict.RestoreBuiltIn}" Command="{Binding RestoreBuiltInCommand}" Margin="8,0,0,0"
                                Visibility="{Binding IsBuiltInSelected, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>

                    <TextBlock Text="{loc:Loc Dict.AppliesNextMeeting}" Margin="0,8,0,0"
                               Foreground="{StaticResource MutedBrush}" FontSize="11" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
