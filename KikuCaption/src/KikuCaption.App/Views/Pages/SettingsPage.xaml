<UserControl x:Class="KikuCaption.App.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:KikuCaption.App.Localization">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Loc Settings.Title}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

        <TabControl Grid.Row="1" BorderThickness="0" Background="Transparent">
            <!-- ==================== General ==================== -->
            <TabItem Header="{loc:Loc Settings.Tab.General}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding General}">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left" Margin="4,14,4,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="190" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc General.UiLanguage}" VerticalAlignment="Center" Margin="0,6" />
                            <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,6" Width="200" HorizontalAlignment="Left"
                                      ItemsSource="{Binding UiLanguages}" DisplayMemberPath="Display"
                                      SelectedValuePath="Code" SelectedValue="{Binding UiLanguage}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc General.DefaultRecognitionLanguage}" VerticalAlignment="Center" Margin="0,6" />
                            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,6" Width="200" HorizontalAlignment="Left"
                                      ItemsSource="{Binding RecognitionLanguages}" SelectedItem="{Binding DefaultRecognitionLanguage}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{loc:LangName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc General.OutputDirectory}" VerticalAlignment="Center" Margin="0,6" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Width="240" Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                                    <Button Content="{loc:Loc General.Browse}" Click="BrowseOutput_Click" Margin="8,0,0,0" />
                                </StackPanel>
                                <!-- Own line + wrapping so long localized hints (e.g. Japanese) are never clipped. -->
                                <TextBlock Text="{loc:Loc Common.AfterRestart}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Foreground="{StaticResource MutedBrush}" FontSize="11" />
                            </StackPanel>

                            <CheckBox Grid.Row="3" Grid.Column="1" Margin="0,6" Content="{loc:Loc General.LoadRecentOnStartup}" IsChecked="{Binding LoadRecentOnStartup}" />
                            <CheckBox Grid.Row="4" Grid.Column="1" Margin="0,6" Content="{loc:Loc General.DefaultTranslationEnabled}" IsChecked="{Binding DefaultTranslationEnabled}" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:Loc General.DefaultRecordingTarget}" VerticalAlignment="Center" Margin="0,6" />
                            <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,6" Width="200" HorizontalAlignment="Left"
                                      ItemsSource="{Binding RecordingTargets}" SelectedItem="{Binding DefaultRecordingTarget}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{loc:LocValue Prefix=Capture.}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="{loc:Loc General.LogRetentionDays}" VerticalAlignment="Center" Margin="0,6" />
                            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,6">
                                <Slider Width="200" Minimum="1" Maximum="90" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding LogRetentionDays}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding LogRetentionDays}" VerticalAlignment="Center" Margin="10,0,0,0" MinWidth="28" />
                            </StackPanel>
                        </Grid>

                        <!-- UI-R5B system tray -->
                        <CheckBox Margin="0,10,0,0"
                                  Content="{loc:Loc General.MinimizeToTray}" IsChecked="{Binding MinimizeToTray}" />
                        <CheckBox Margin="0,6,0,0"
                                  Content="{loc:Loc General.CloseToTray}" IsChecked="{Binding CloseToTray}" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <CheckBox Content="{loc:Loc General.AutoCorrectAfterMeeting}"
                                      IsChecked="{Binding AutoCorrectAfterMeeting}"
                                      IsEnabled="{Binding IsCorrectionModelAvailable}" />
                            <Border Margin="7,0,0,0" Width="18" Height="18" CornerRadius="9"
                                    BorderBrush="{StaticResource MutedBrush}" BorderThickness="1"
                                    ToolTip="{Binding CorrectionModelHint}">
                                <TextBlock Text="?" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{loc:Loc General.AutoCorrectHint}" TextWrapping="Wrap" Margin="24,3,0,0"
                                   Foreground="{StaticResource MutedBrush}" FontSize="11" />

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <CheckBox Content="{loc:Loc General.PrewarmWhisper}"
                                      IsChecked="{Binding PrewarmWhisperInBackground}" />
                            <Border Margin="7,0,0,0" Width="18" Height="18" CornerRadius="9"
                                    BorderBrush="{StaticResource MutedBrush}" BorderThickness="1"
                                    ToolTip="{loc:Loc General.PrewarmWhisperHint}">
                                <TextBlock Text="?" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{loc:Loc Settings.NextMeetingHint}" TextWrapping="Wrap" Margin="0,12,0,0"
                                   Foreground="{StaticResource MutedBrush}" FontSize="12" />

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="{loc:Loc Settings.Save}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
                            <Button Content="{loc:Loc Settings.RestoreDefaults}" Command="{Binding RestoreDefaultsCommand}" Margin="8,0,0,0" />
                            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== Subtitle ==================== -->
            <TabItem Header="{loc:Loc Settings.Tab.Subtitle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Subtitle}">
                    <Grid Margin="4,14,4,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>

                        <!-- Controls -->
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <CheckBox Content="{loc:Loc Subtitle.DefaultShowOverlay}" IsChecked="{Binding Overlay.DefaultVisible}" Margin="0,4" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Subtitle.FontSize}" VerticalAlignment="Center" Margin="0,6" />
                                <Slider Grid.Row="0" Grid.Column="1" Minimum="10" Maximum="48" Margin="0,6" VerticalAlignment="Center"
                                        Value="{Binding Overlay.FontSize}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Subtitle.FontFamily}" VerticalAlignment="Center" Margin="0,6" />
                                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,6" ItemsSource="{Binding FontFamilies}" SelectedItem="{Binding Overlay.FontFamily}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Subtitle.BackgroundOpacity}" VerticalAlignment="Center" Margin="0,6" />
                                <Slider Grid.Row="2" Grid.Column="1" Minimum="0.3" Maximum="1.0" Margin="0,6" VerticalAlignment="Center"
                                        Value="{Binding Overlay.BackgroundOpacity}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Subtitle.MaxLines}" VerticalAlignment="Center" Margin="0,6" />
                                <Slider Grid.Row="3" Grid.Column="1" Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,6" VerticalAlignment="Center"
                                        Value="{Binding Overlay.MaxLines}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Loc Subtitle.PartialOpacity}" VerticalAlignment="Center" Margin="0,6" />
                                <Slider Grid.Row="4" Grid.Column="1" Minimum="0.2" Maximum="1.0" Margin="0,6" VerticalAlignment="Center"
                                        Value="{Binding Overlay.PartialOpacity}" />
                            </Grid>

                            <WrapPanel Margin="0,4,0,0">
                                <CheckBox Content="{loc:Loc Subtitle.Topmost}" IsChecked="{Binding Overlay.Topmost}" Margin="0,4,16,4" />
                                <CheckBox Content="{loc:Loc Subtitle.ClickThrough}" IsChecked="{Binding Overlay.ClickThrough}" Margin="0,4,16,4" />
                                <CheckBox Content="{loc:Loc Subtitle.ShowOriginal}" IsChecked="{Binding Overlay.ShowOriginal}" Margin="0,4,16,4" />
                                <CheckBox Content="{loc:Loc Subtitle.ShowTranslation}" IsChecked="{Binding Overlay.ShowTranslation}" Margin="0,4,16,4" />
                            </WrapPanel>

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Subtitle.OriginalColor}" VerticalAlignment="Center" Margin="0,4" />
                                <TextBox Grid.Row="0" Grid.Column="1" Width="110" Margin="0,4" Text="{Binding Overlay.OriginalColor, UpdateSourceTrigger=PropertyChanged}" />
                                <Border Grid.Row="0" Grid.Column="2" Width="24" Height="24" Margin="8,4,0,4" CornerRadius="4"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{Binding Overlay.OriginalColor}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Subtitle.TranslationColor}" VerticalAlignment="Center" Margin="0,4" />
                                <TextBox Grid.Row="1" Grid.Column="1" Width="110" Margin="0,4" Text="{Binding Overlay.TranslationColor, UpdateSourceTrigger=PropertyChanged}" />
                                <Border Grid.Row="1" Grid.Column="2" Width="24" Height="24" Margin="8,4,0,4" CornerRadius="4"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{Binding Overlay.TranslationColor}" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="{loc:Loc Settings.Save}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
                                <Button Content="{loc:Loc Subtitle.RestoreDefaults}" Command="{Binding RestoreDefaultsCommand}" Margin="8,0,0,0" />
                                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource AccentBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Live preview -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{loc:Loc Subtitle.Preview}" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <Border CornerRadius="8" Padding="16,12" Background="#2B2B2B">
                                <Border CornerRadius="6" Padding="12,10">
                                    <Border.Background>
                                        <SolidColorBrush Color="Black" Opacity="{Binding Overlay.BackgroundOpacity}" />
                                    </Border.Background>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SampleOriginal}" TextWrapping="Wrap"
                                                   Foreground="{Binding Overlay.OriginalColor}"
                                                   FontFamily="{Binding Overlay.FontFamily}"
                                                   FontSize="{Binding Overlay.FontSize}"
                                                   Visibility="{Binding Overlay.ShowOriginal, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding SampleTranslation}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Foreground="{Binding Overlay.TranslationColor}"
                                                   FontFamily="{Binding Overlay.FontFamily}"
                                                   FontSize="{Binding Overlay.FontSize}"
                                                   Visibility="{Binding Overlay.ShowTranslation, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding SamplePartial}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Foreground="{Binding Overlay.OriginalColor}" Opacity="{Binding Overlay.PartialOpacity}"
                                                   FontFamily="{Binding Overlay.FontFamily}"
                                                   FontSize="{Binding Overlay.FontSize}" />
                                    </StackPanel>
                                </Border>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== Translation ==================== -->
            <TabItem Header="{loc:Loc Settings.Tab.Translation}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Translation}">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left" Margin="4,14,4,4">
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" Text="{loc:Loc Tr.Intro}" />
                        <CheckBox Content="{loc:Loc Tr.Enable}" IsChecked="{Binding Enabled}" Margin="0,0,0,8" />

                        <!-- UI-R4A: source follows recognition (read-only); target is configurable. -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Tr.SourceLanguage}" VerticalAlignment="Center" Margin="0,4" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{loc:Loc Tr.SourceFollow}" VerticalAlignment="Center" Margin="0,4"
                                       Foreground="{StaticResource MutedBrush}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Tr.TargetLanguage}" VerticalAlignment="Center" Margin="0,4" />
                            <ComboBox Grid.Row="1" Grid.Column="1" Width="200" HorizontalAlignment="Left" Margin="0,4"
                                      ItemsSource="{Binding TargetLanguages}" SelectedItem="{Binding TargetLanguage}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{loc:LangName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Tr.CurrentDirection}" VerticalAlignment="Center" Margin="0,4" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DirectionText}" VerticalAlignment="Center" Margin="0,4" FontWeight="SemiBold" />
                        </Grid>
                        <TextBlock Text="{loc:Loc Tr.SameLanguageNote}" TextWrapping="Wrap" Foreground="#B26A00" FontSize="12" Margin="0,0,0,4"
                                   Visibility="{Binding IsSameLanguage, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{loc:Loc Common.NextMeeting}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,8" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Endpoint" VerticalAlignment="Center" Margin="0,2,8,2" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Model/Deployment" VerticalAlignment="Center" Margin="0,2,8,2" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="API Version" VerticalAlignment="Center" Margin="0,2,8,2" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ApiVersion, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Tr.AuthMode}" VerticalAlignment="Center" Margin="0,2,8,2" />
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                <ComboBox Width="160" ItemsSource="{Binding AuthModes}" SelectedItem="{Binding AuthenticationMode}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{loc:LocValue Prefix=Auth.}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="{loc:Loc Tr.HeaderName}" VerticalAlignment="Center" Margin="12,0,6,0" />
                                <TextBox Width="140" Text="{Binding HeaderName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Loc Tr.ApiKey}" VerticalAlignment="Center" Margin="0,2,8,2" />
                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                <PasswordBox x:Name="ApiKeyBox" Width="220" />
                                <Button Content="{loc:Loc Tr.SaveKey}" Click="SaveApiKey_Click" Margin="8,0,0,0" />
                                <Button Content="{loc:Loc Tr.ClearKey}" Command="{Binding ClearApiKeyCommand}" Margin="6,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{loc:Loc Tr.Proxy}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Width="300" Text="{Binding Proxy, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <!-- Numeric fields: invalid text fails binding validation (no crash) and is not
                             applied; values are clamped to their ranges before saving (UI-R4A fix). -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{loc:Loc Tr.Timeout}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Width="70" Text="{Binding TimeoutSeconds, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Text="{loc:Loc Tr.MaxRetries}" VerticalAlignment="Center" Margin="24,0,8,0" />
                            <TextBox Width="70" Text="{Binding MaxRetries, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="{loc:Loc Tr.TestConnection}" Command="{Binding TestConnectionCommand}"
                                    IsEnabled="{Binding TestInProgress, Converter={StaticResource InverseBool}}" />
                            <Button Content="{loc:Loc Tr.SaveSettings}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                    Command="{Binding SaveSettingsCommand}" />
                            <TextBlock Text="{Binding KeyStatusText}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>

                        <TextBlock Text="{Binding TestStatus}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="{Binding QueueStatus}" Margin="0,2,0,0" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="{Binding LastErrorText}" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="#B26A00" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== About ==================== -->
            <TabItem Header="{loc:Loc Settings.Tab.About}">
                <StackPanel MaxWidth="620" HorizontalAlignment="Left" Margin="4,20,4,4">
                    <TextBlock Text="KikuCaption" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="{Binding About.VersionText, Mode=OneWay}" Margin="0,5,0,18" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{loc:Loc About.Description}" TextWrapping="Wrap" FontSize="14" />
                    <Separator Margin="0,18,0,14" />
                    <TextBlock Text="Designed &amp; built by Yu" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="Contributor: Claude" Margin="0,6,0,0" />
                    <TextBlock Text="{loc:Loc About.Privacy}" TextWrapping="Wrap" Margin="0,18,0,0"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
