<UserControl x:Class="KikuCaption.App.Views.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:KikuCaption.App.Behaviors"
             xmlns:loc="clr-namespace:KikuCaption.App.Localization">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== Compact meeting control bar ==================== -->
        <Border Grid.Row="0" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Recognition language (shows 日本語, value stays the ja/zh code) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc Home.RecognitionLanguage}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                    <ComboBox Width="96" Margin="8,0,0,0" ItemsSource="{Binding Realtime.Languages}"
                              SelectedItem="{Binding Realtime.SelectedLanguage}"
                              IsEnabled="{Binding Realtime.IsRunning, Converter={StaticResource InverseBool}}"
                              ToolTip="{loc:Loc Home.LanguageTooltip}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{loc:LangName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Translation toggle + direction (source follows recognition; target from session
                     snapshot while running). Prefix: 翻译中/无需翻译; dimmed when off or same-language. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <CheckBox Content="{loc:Loc Home.Translation}" IsChecked="{Binding Translation.Enabled}" VerticalAlignment="Center" />
                    <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource MutedBrush}">
                        <Run Text="{Binding TranslationPrefix, Mode=OneWay}" /><Run Text="{Binding TranslationDirectionText, Mode=OneWay}" />
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Opacity" Value="1.0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TranslationDimmed}" Value="True">
                                        <Setter Property="Opacity" Value="0.4" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Content="{loc:Loc Home.NotConfiguredConfigure}" Style="{StaticResource NavButton}" Padding="8,3" Margin="8,0,0,0"
                            Foreground="#B26A00" FontSize="12"
                            Command="{Binding DataContext.GoSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Visibility="{Binding TranslationNotConfiguredHint, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!-- Primary + session actions -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{loc:Loc Home.StartMeeting}" Style="{StaticResource PrimaryButton}" MinWidth="110" Click="StartMeeting_Click"
                            IsEnabled="{Binding Realtime.CanStartMeeting}" />
                    <Button Content="{loc:Loc Home.Stop}" Style="{StaticResource DangerButton}" MinWidth="80" Margin="8,0,0,0"
                            Command="{Binding Realtime.StopCommand}"
                            Visibility="{Binding Realtime.IsRunning, Converter={StaticResource BoolToVisibility}}" />
                    <!-- Overlay button text follows the overlay visibility (show / hide) -->
                    <Button Margin="8,0,0,0" Command="{Binding Realtime.ToggleOverlayCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Content" Value="{loc:Loc Home.ShowOverlay}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Realtime.Overlay.IsVisible}" Value="True">
                                        <Setter Property="Content" Value="{loc:Loc Home.HideOverlay}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== Session card (left) + timeline (right) ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Current session + recent meeting history. -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="16" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Session.Title}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Session.State}" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,6" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Realtime.SessionStateText}" Margin="0,0,0,6" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Session.Elapsed}" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,6" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ElapsedText}" Margin="0,0,0,6" FontFamily="Consolas" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Session.Language}" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,6" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Realtime.SelectedLanguageDisplay}" Margin="0,0,0,6" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Session.Direction}" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,6" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TranslationDirectionText}" Margin="0,0,0,6" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Loc Session.Recording}" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,6" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Realtime.RecorderStatus}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,4,0,10" />

                    <TextBlock Text="{Binding Realtime.StatusText}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                    <TextBlock Text="{Binding Realtime.HealthText}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"
                               Visibility="{Binding Realtime.HealthText, Converter={StaticResource NonEmptyToVisibility}}" />
                    <TextBlock Text="{Binding RecoveryStatus}" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,4,0,0"
                               Visibility="{Binding RecoveryStatus, Converter={StaticResource NonEmptyToVisibility}}" />
                    <TextBlock Text="{Binding Realtime.ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,4,0,0"
                               Visibility="{Binding Realtime.HasError, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding Realtime.StorageError}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,4,0,0"
                               Visibility="{Binding Realtime.HasStorageError, Converter={StaticResource BoolToVisibility}}" />
                    <Border Background="#FFF4CE" BorderBrush="#E6B800" BorderThickness="1" CornerRadius="5" Padding="8,6" Margin="0,8,0,0"
                            Visibility="{Binding Realtime.HasAudioQualityWarning, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Realtime.AudioQualityWarning}" TextWrapping="Wrap" Foreground="#7A5200" FontSize="12" />
                    </Border>
                </StackPanel>
            </Border>

                <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="10" Margin="0,12,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="4,2,2,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc History.Title}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="↻" Padding="7,2" Background="Transparent" BorderThickness="0"
                                    ToolTip="{loc:Loc History.Refresh}" Command="{Binding RefreshRecentMeetingsCommand}" />
                        </Grid>

                        <Grid Grid.Row="1">
                            <ListBox ItemsSource="{Binding RecentMeetings}" BorderThickness="0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,5" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Button Style="{StaticResource NavButton}" HorizontalContentAlignment="Stretch" Padding="8,7"
                                                    Command="{Binding DataContext.LoadHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DateText}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding DetailText}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding ArtifactText}" FontSize="11" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0"
                                                               Visibility="{Binding ArtifactText, Converter={StaticResource NonEmptyToVisibility}}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="1" Content="{loc:Loc Playback.Open}" Margin="4,5,4,5" Padding="8,4"
                                                    Click="OpenPlayback_Click"
                                                    Visibility="{Binding HasRecording, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{loc:Loc History.Empty}" TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="8,16"
                                       Visibility="{Binding HasNoRecentMeetings, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding RecentMeetingsError}" TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="8,16"
                                       Visibility="{Binding RecentMeetingsError, Converter={StaticResource NonEmptyToVisibility}}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Meeting timeline (kept in full; MinWidth keeps it readable on narrow windows) -->
            <Border Grid.Column="1" Margin="12,0,0,0" MinWidth="360" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <Grid DataContext="{Binding Realtime.Timeline}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header: count + overflow menu (load recent / clear) -->
                    <Grid Grid.Row="0" Margin="12,12,10,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" FontSize="15">
                                <Run Text="{loc:Loc Timeline.HeaderPrefix}" /><Run Text="{Binding FinalCount, Mode=OneWay}" /><Run Text="{loc:Loc Timeline.HeaderSuffix}" />
                            </TextBlock>
                            <TextBlock Text="{loc:Loc Timeline.Hint}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,1,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                            <Button Content="{loc:Loc Summary.Generate}" Style="{StaticResource PrimaryButton}" Padding="12,6"
                                    Click="GenerateSummary_Click"
                                    IsEnabled="{Binding DataContext.CanGenerateSummary, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <Button Content="{loc:Loc Summary.Open}" Margin="6,0,0,0" Padding="10,6"
                                    Click="OpenSummary_Click"
                                    Visibility="{Binding DataContext.SummaryFileExists, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <ToggleButton x:Name="TimelineMenuToggle" Grid.Column="2" Content="⋯" FontSize="16" Padding="10,2"
                                      Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"
                                      AutomationProperties.Name="{loc:Loc Timeline.Menu}" ToolTip="{loc:Loc Timeline.Menu}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup Grid.Column="2" IsOpen="{Binding IsChecked, ElementName=TimelineMenuToggle}" PlacementTarget="{Binding ElementName=TimelineMenuToggle}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-140">
                            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,4,0,0" MinWidth="150">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.18" />
                                </Border.Effect>
                                <StackPanel>
                                    <Button Content="{loc:Loc Timeline.LoadRecent}" HorizontalContentAlignment="Left" Style="{StaticResource NavButton}"
                                            Click="TimelineMenuItem_Click" Command="{Binding LoadMostRecentSessionCommand}"
                                            IsEnabled="{Binding IsLoadingHistory, Converter={StaticResource InverseBool}}" />
                                    <Button Content="{loc:Loc Timeline.ClearDisplay}" HorizontalContentAlignment="Left" Style="{StaticResource NavButton}"
                                            Click="TimelineMenuItem_Click" Command="{Binding ClearDisplayCommand}" />
                                    <Separator Margin="4,4" />
                                    <!-- UI-R5C: bound to the page view model (not the timeline) via the ancestor UserControl. -->
                                    <Button Content="{loc:Loc Summary.Generate}" HorizontalContentAlignment="Left" Style="{StaticResource NavButton}"
                                            Click="GenerateSummary_Click"
                                            IsEnabled="{Binding DataContext.CanGenerateSummary, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    <Button Content="{loc:Loc Summary.Open}" HorizontalContentAlignment="Left" Style="{StaticResource NavButton}"
                                            Click="OpenSummary_Click"
                                            IsEnabled="{Binding DataContext.SummaryFileExists, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    <Button Content="{loc:Loc Summary.ShowInFolder}" HorizontalContentAlignment="Left" Style="{StaticResource NavButton}"
                                            Click="ShowSummaryFolder_Click" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- Virtualized timeline -->
                    <Grid Grid.Row="1">
                        <ListBox ItemsSource="{Binding Entries}"
                                 behaviors:TimelineAutoScroll.ViewModel="{Binding}"
                                 BorderThickness="0" Background="Transparent"
                                 HorizontalContentAlignment="Stretch"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,6" Margin="6,2,6,2" Background="#FFFFFF" CornerRadius="6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Time}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding Translation}" TextWrapping="Wrap" FontSize="14"
                                                       Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0"
                                                       Visibility="{Binding HasTranslation, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="{loc:Loc Timeline.Translating}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"
                                                       Visibility="{Binding IsTranslating, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="{loc:Loc Timeline.TranslationFailed}" FontSize="11" Foreground="#B26A00" Margin="0,2,0,0"
                                                       Visibility="{Binding HasFailed, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Empty state (no running session, no captions yet). Bound to the page VM. -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="280"
                                    Visibility="{Binding DataContext.HasNoSession, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="🎙" FontSize="34" HorizontalAlignment="Center" Opacity="0.5" />
                            <TextBlock Text="{loc:Loc Timeline.EmptyTitle}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" />
                            <TextBlock Text="{loc:Loc Timeline.EmptyHint}" TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- "有 N 条新字幕" jump-to-latest -->
                        <Button VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,10"
                                Padding="14,6" FontSize="12" Foreground="White" Background="{StaticResource AccentBrush}" BorderThickness="0"
                                Content="{Binding NewMessagesText}" Command="{Binding JumpToLatestCommand}"
                                Visibility="{Binding HasNewMessages, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>

                    <!-- Bottom "recognizing" partial line -->
                    <Border Grid.Row="2" Background="#FFF8E1" Padding="10,6" Margin="6,2,6,2" CornerRadius="6"
                            Visibility="{Binding HasPartial, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="#7A5A00">
                            <Run Text="{loc:Loc Timeline.Recognizing}" /><Run Text="{Binding PartialText, Mode=OneWay}" />
                        </TextBlock>
                    </Border>

                    <TextBlock Grid.Row="3" Text="{Binding HistoryStatus}" Foreground="{StaticResource MutedBrush}" FontSize="11"
                               TextWrapping="Wrap" Margin="12,4,12,8" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
