<UserControl x:Class="KikuCaption.App.Views.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:KikuCaption.App.Behaviors">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== Compact meeting control bar ==================== -->
        <Border Grid.Row="0" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Recognition language -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="识别语言" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                    <ComboBox Width="72" Margin="8,0,0,0" ItemsSource="{Binding Realtime.Languages}"
                              SelectedItem="{Binding Realtime.SelectedLanguage}"
                              IsEnabled="{Binding Realtime.IsRunning, Converter={StaticResource InverseBool}}"
                              ToolTip="选择识别语言（会话运行中不可更改）" />
                </StackPanel>

                <!-- Translation toggle + direction -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <CheckBox Content="翻译" IsChecked="{Binding Translation.Enabled}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Translation.DirectionText}" VerticalAlignment="Center" Margin="8,0,0,0"
                               Foreground="{StaticResource MutedBrush}" />
                    <Button Content="未配置，点此设置" Style="{StaticResource NavButton}" Padding="8,3" Margin="8,0,0,0"
                            Foreground="#B26A00" FontSize="12"
                            Command="{Binding DataContext.GoSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Visibility="{Binding TranslationNotConfiguredHint, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!-- Primary + session actions -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="开始会议" Style="{StaticResource PrimaryButton}" MinWidth="110" Click="StartMeeting_Click"
                            IsEnabled="{Binding Realtime.IsRunning, Converter={StaticResource InverseBool}}" />
                    <Button Content="停止" Style="{StaticResource DangerButton}" MinWidth="80" Margin="8,0,0,0"
                            Command="{Binding Realtime.StopCommand}"
                            Visibility="{Binding Realtime.IsRunning, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="显示/隐藏浮窗" Margin="8,0,0,0" Command="{Binding Realtime.ToggleOverlayCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== Session card (left) + timeline (right) ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Current-session status card -->
            <Border Grid.Column="0" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="16" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="当前会话" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="状态" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,6" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Realtime.SessionStateText}" Margin="0,0,0,6" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="已运行" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,6" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ElapsedText}" Margin="0,0,0,6" FontFamily="Consolas" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="识别语言" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,6" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Realtime.SelectedLanguage}" Margin="0,0,0,6" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="翻译方向" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,6" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Translation.DirectionText}" Margin="0,0,0,6" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="录制" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,6" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Realtime.RecorderStatus}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,4,0,10" />

                    <TextBlock Text="{Binding Realtime.StatusText}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                    <TextBlock Text="{Binding Realtime.HealthText}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"
                               Visibility="{Binding Realtime.HealthText, Converter={StaticResource NonEmptyToVisibility}}" />
                    <TextBlock Text="{Binding RecoveryStatus}" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,4,0,0"
                               Visibility="{Binding RecoveryStatus, Converter={StaticResource NonEmptyToVisibility}}" />
                    <TextBlock Text="{Binding Realtime.ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,4,0,0"
                               Visibility="{Binding Realtime.HasError, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding Realtime.StorageError}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,4,0,0"
                               Visibility="{Binding Realtime.HasStorageError, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- Meeting timeline (kept in full) -->
            <Border Grid.Column="1" Margin="12,0,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <Grid DataContext="{Binding Realtime.Timeline}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header: count + overflow menu (load recent / clear) -->
                    <Grid Grid.Row="0" Margin="12,12,10,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" FontSize="15">
                                <Run Text="会议字幕（全程 " /><Run Text="{Binding FinalCount, Mode=OneWay}" /><Run Text=" 条）" />
                            </TextBlock>
                            <TextBlock Text="最早在上、最新在下；上滑查看历史不会被打断。" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,1,0,0" />
                        </StackPanel>

                        <ToggleButton x:Name="TimelineMenuToggle" Grid.Column="1" Content="⋯" FontSize="16" Padding="10,2"
                                      Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"
                                      AutomationProperties.Name="时间线菜单" ToolTip="更多操作">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup Grid.Column="1" IsOpen="{Binding IsChecked, ElementName=TimelineMenuToggle}" PlacementTarget="{Binding ElementName=TimelineMenuToggle}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-140">
                            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,4,0,0" MinWidth="150">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.18" />
                                </Border.Effect>
                                <StackPanel>
                                    <Button Content="加载最近会话" HorizontalContentAlignment="Left" Style="{StaticResource NavButton}"
                                            Click="TimelineMenuItem_Click" Command="{Binding LoadMostRecentSessionCommand}"
                                            IsEnabled="{Binding IsLoadingHistory, Converter={StaticResource InverseBool}}" />
                                    <Button Content="清空显示" HorizontalContentAlignment="Left" Style="{StaticResource NavButton}"
                                            Click="TimelineMenuItem_Click" Command="{Binding ClearDisplayCommand}" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- Virtualized timeline -->
                    <Grid Grid.Row="1">
                        <ListBox ItemsSource="{Binding Entries}"
                                 behaviors:TimelineAutoScroll.ViewModel="{Binding}"
                                 BorderThickness="0" Background="Transparent"
                                 HorizontalContentAlignment="Stretch"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,6" Margin="6,2,6,2" Background="#FFFFFF" CornerRadius="6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Time}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding Translation}" TextWrapping="Wrap" FontSize="14"
                                                       Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0"
                                                       Visibility="{Binding HasTranslation, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="翻译中…" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"
                                                       Visibility="{Binding IsTranslating, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="⚠ 翻译失败（已保留原文）" FontSize="11" Foreground="#B26A00" Margin="0,2,0,0"
                                                       Visibility="{Binding HasFailed, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Empty state (no running session, no captions yet). Bound to the page VM. -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="280"
                                    Visibility="{Binding DataContext.HasNoSession, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="🎙" FontSize="34" HorizontalAlignment="Center" Opacity="0.5" />
                            <TextBlock Text="还没有会议字幕" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" />
                            <TextBlock Text="点击右上角“开始会议”，即可开始录制并实时显示字幕。" TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- "有 N 条新字幕" jump-to-latest -->
                        <Button VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,10"
                                Padding="14,6" FontSize="12" Foreground="White" Background="{StaticResource AccentBrush}" BorderThickness="0"
                                Content="{Binding NewMessagesText}" Command="{Binding JumpToLatestCommand}"
                                Visibility="{Binding HasNewMessages, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>

                    <!-- Bottom "recognizing" partial line -->
                    <Border Grid.Row="2" Background="#FFF8E1" Padding="10,6" Margin="6,2,6,2" CornerRadius="6"
                            Visibility="{Binding HasPartial, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="#7A5A00">
                            <Run Text="正在识别：" /><Run Text="{Binding PartialText, Mode=OneWay}" />
                        </TextBlock>
                    </Border>

                    <TextBlock Grid.Row="3" Text="{Binding HistoryStatus}" Foreground="{StaticResource MutedBrush}" FontSize="11"
                               TextWrapping="Wrap" Margin="12,4,12,8" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
