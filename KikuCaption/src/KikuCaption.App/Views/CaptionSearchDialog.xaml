<Window x:Class="KikuCaption.App.Views.CaptionSearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:KikuCaption.App.Localization"
        Title="{loc:Loc Search.Title}" Width="680" Height="520" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource WindowBrush}" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{loc:Loc Search.Hint}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" />
        <TextBox x:Name="QueryBox" Grid.Row="1" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="34" Padding="8,5" VerticalContentAlignment="Center"
                 ToolTip="{loc:Loc Search.Placeholder}" />

        <Border Grid.Row="2" Margin="0,10,0,10" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="7" Background="White">
            <ListBox x:Name="ResultList" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}"
                     BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="ResultList_MouseDoubleClick"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="10,7">
                            <TextBlock Text="{Binding TimeText, Mode=OneWay}" FontSize="11"
                                       Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="{Binding Text, Mode=OneWay}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding Translation, Mode=OneWay}" TextWrapping="Wrap" Margin="0,3,0,0"
                                       Foreground="{StaticResource AccentBrush}"
                                       Visibility="{Binding HasTranslation, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}">
                <Run Text="{Binding ResultCount, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding TotalCount, Mode=OneWay}"/>
            </TextBlock>
            <Button Grid.Column="1" Content="{loc:Loc Search.Cancel}" MinWidth="82" IsCancel="True" />
            <Button Grid.Column="2" Content="{loc:Loc Search.Jump}" Style="{StaticResource PrimaryButton}"
                    MinWidth="100" Margin="8,0,0,0" IsDefault="True" Click="Jump_Click" />
        </Grid>
    </Grid>
</Window>
