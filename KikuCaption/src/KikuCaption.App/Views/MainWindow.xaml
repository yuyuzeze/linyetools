<Window x:Class="KikuCaption.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:KikuCaption.App.Localization"
        Title="KikuCaption" Height="820" Width="1180" MinWidth="900" MinHeight="600"
        Background="{StaticResource WindowBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== Top function bar ==================== -->
        <Border Grid.Row="0" Background="{StaticResource BarBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="14,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: brand + primary navigation -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="KikuCaption" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"
                               Margin="4,0,16,0" Foreground="{StaticResource AccentBrush}" />
                    <Button Content="{loc:Loc Nav.Home}" Style="{StaticResource NavButton}" Command="{Binding GoHomeCommand}"
                            Tag="{Binding IsHomeSelected}" AutomationProperties.Name="{loc:Loc Nav.Home}" />
                    <Button Content="{loc:Loc Nav.Audio}" Style="{StaticResource NavButton}" Command="{Binding GoAudioCommand}"
                            Tag="{Binding IsAudioSelected}" AutomationProperties.Name="{loc:Loc Nav.Audio}" />
                    <Button Content="{loc:Loc Nav.Dictionary}" Style="{StaticResource NavButton}" Command="{Binding GoDictionaryCommand}"
                            Tag="{Binding IsDictionarySelected}" AutomationProperties.Name="{loc:Loc Nav.Dictionary}" />
                    <Button Content="{loc:Loc Nav.Settings}" Style="{StaticResource NavButton}" Command="{Binding GoSettingsCommand}"
                            Tag="{Binding IsSettingsSelected}" AutomationProperties.Name="{loc:Loc Nav.Settings}" />
                </StackPanel>

                <!-- Right: environment status cluster (dot + text + dropdown) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            DataContext="{Binding Environment}">
                    <!-- Dot + text: clicking navigates straight to the environment page -->
                    <Button Style="{StaticResource NavButton}"
                            Command="{Binding DataContext.GoEnvironmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="{Binding OverallMessage}"
                            AutomationProperties.Name="{loc:Loc Nav.EnvironmentStatus}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="12" Height="12" CornerRadius="6" VerticalAlignment="Center"
                                    Background="{Binding HealthColor}" />
                            <TextBlock Text="{Binding HealthText}" VerticalAlignment="Center" Margin="7,0,0,0" FontSize="13" />
                        </StackPanel>
                    </Button>

                    <!-- Dropdown: environment detail / re-check -->
                    <ToggleButton x:Name="EnvMenuToggle" Content="▾" Padding="8,4" Margin="2,0,0,0"
                                  Background="Transparent" BorderThickness="0" Cursor="Hand"
                                  AutomationProperties.Name="{loc:Loc Nav.EnvironmentMenu}" ToolTip="{loc:Loc Nav.EnvironmentMenu}">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Margin="{TemplateBinding Padding}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavHoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavHoverBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <Popup IsOpen="{Binding IsChecked, ElementName=EnvMenuToggle}" PlacementTarget="{Binding ElementName=EnvMenuToggle}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-120">
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="4" Margin="0,4,0,0" MinWidth="160">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.18" />
                            </Border.Effect>
                            <StackPanel>
                                <Button Content="{loc:Loc Nav.EnvironmentDetail}" HorizontalContentAlignment="Left" Style="{StaticResource NavButton}"
                                        Click="EnvMenuItem_Click"
                                        Command="{Binding DataContext.GoEnvironmentCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <Button Content="{loc:Loc Nav.RecheckEnvironment}" HorizontalContentAlignment="Left" Style="{StaticResource NavButton}"
                                        Click="EnvMenuItem_Click"
                                        Command="{Binding DataContext.RecheckEnvironmentCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== Hosted page ==================== -->
        <ContentControl Grid.Row="1" Margin="16" Content="{Binding Navigation.CurrentViewModel}" />
    </Grid>
</Window>
