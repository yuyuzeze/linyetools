<Window x:Class="KikuCaption.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:KikuCaption.App.Behaviors"
        Title="KikuCaption" Height="820" Width="1180"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="KikuCaption" FontSize="24" FontWeight="Bold" />
        <StackPanel Grid.Row="1" Margin="0,4,0,12">
            <TextBlock Foreground="#555"
                       Text="环境检查（M0）、音频捕获（M1）、语音识别（M2）、实时字幕（M3）与字幕持久化（M4）。" />
            <TextBlock Text="{Binding RecoveryStatus}" Foreground="#1565C0" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="430" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="#F3F3F3" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{Binding OverallMessage}" TextWrapping="Wrap" FontSize="14" />
                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,0,0"
                                     Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6"
                                    Padding="12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="14" Height="14" CornerRadius="7"
                                            VerticalAlignment="Top" Margin="0,3,10,0"
                                            Background="{Binding StatusColor}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Text="{Binding DetectedVersion}" Foreground="#666" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding Remediation}" TextWrapping="Wrap" Foreground="#1565C0" Margin="0,4,0,0"
                                                   Visibility="{Binding HasRemediation, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{Binding StatusColor}" CornerRadius="4" Padding="8,2" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="12" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Milestone 1: system audio capture -->
                <GroupBox Header="系统音频捕获（Milestone 1 验证）" Margin="0,4,0,0" Padding="10"
                          DataContext="{Binding Audio}">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,8"
                                   Text="将系统输出声音录制为 16 kHz / 单声道 / 16-bit PCM 的 WAV。请在捕获期间播放音频。" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="开始捕获…" Click="StartCapture_Click" Padding="14,6" MinWidth="110"
                                    IsEnabled="{Binding IsCapturing, Converter={StaticResource InverseBool}}" />
                            <Button Content="停止" Command="{Binding StopCommand}" Padding="14,6" MinWidth="80" Margin="8,0,0,0"
                                    IsEnabled="{Binding IsCapturing}" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding OutputPath}" Foreground="#666" TextWrapping="Wrap" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </GroupBox>

                <!-- Milestone 2: local speech recognition -->
                <GroupBox Header="本地语音识别（Milestone 2 验证）" Margin="0,10,0,0" Padding="10"
                          DataContext="{Binding Speech}">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,8"
                                   Text="用本地 faster-whisper 识别一个 WAV 文件，输出带时间戳的文本。首次会加载模型（需先建立 Python 环境并下载 small 模型）。" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="识别语言：" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                                      Width="80" Margin="6,0,0,0" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                            <Button Content="识别 WAV 文件…" Click="RecognizeWav_Click" Padding="14,6" MinWidth="130" Margin="12,0,0,0"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                            <ProgressBar IsIndeterminate="True" Width="120" Height="6" Margin="12,0,0,0"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Results}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontFamily="Consolas" Margin="0,1,0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </GroupBox>

                <!-- Milestone 3: real-time captions + overlay -->
                <GroupBox Header="实时字幕、字幕浮窗与录屏（Milestone 3 / 5）" Margin="0,10,0,0" Padding="10"
                          DataContext="{Binding Realtime}">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,8"
                                   Text="捕获系统声音并实时显示渐进字幕（partial 淡色 / final 亮色），同时录制屏幕/窗口为 MP4。需先建立 Python 环境与 small 模型；录屏需 FFmpeg（tools/ffmpeg）。" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="语言：" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                                      Width="70" Margin="6,0,0,0" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}" />
                            <Button Content="开始录制和字幕" Command="{Binding StartCommand}" Padding="12,6" MinWidth="120" Margin="12,0,0,0"
                                    IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}" />
                            <Button Content="停止" Command="{Binding StopCommand}" Padding="12,6" MinWidth="70" Margin="8,0,0,0"
                                    IsEnabled="{Binding IsRunning}" />
                            <Button Content="显示/隐藏浮窗" Command="{Binding ToggleOverlayCommand}" Padding="12,6" Margin="12,0,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="录制目标：" VerticalAlignment="Center" />
                            <ComboBox Width="110" Margin="6,0,0,0" SelectedValuePath="Tag" SelectedValue="{Binding SelectedCaptureType}"
                                      IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}">
                                <ComboBoxItem Content="整个屏幕" Tag="screen" />
                                <ComboBoxItem Content="指定窗口" Tag="window" />
                            </ComboBox>
                            <ComboBox Width="280" Margin="8,0,0,0" ItemsSource="{Binding Windows}" SelectedItem="{Binding SelectedWindow}"
                                      Visibility="{Binding IsWindowCapture, Converter={StaticResource BoolToVisibility}}"
                                      IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}" />
                            <Button Content="刷新窗口" Command="{Binding RefreshWindowsCommand}" Margin="8,0,0,0" Padding="10,4"
                                    Visibility="{Binding IsWindowCapture, Converter={StaticResource BoolToVisibility}}"
                                    IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}" />
                        </StackPanel>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="字号" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Slider Grid.Row="0" Grid.Column="1" Minimum="14" Maximum="48" VerticalAlignment="Center"
                                    Value="{Binding Overlay.FontSize}" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="透明度" VerticalAlignment="Center" Margin="16,0,8,0" />
                            <Slider Grid.Row="0" Grid.Column="3" Minimum="0.3" Maximum="1.0" VerticalAlignment="Center"
                                    Value="{Binding Overlay.BackgroundOpacity}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="最大行数" VerticalAlignment="Center" Margin="0,8,8,0" />
                            <Slider Grid.Row="1" Grid.Column="1" Minimum="2" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center" Margin="0,8,0,0" Value="{Binding Overlay.MaxLines}" />
                            <CheckBox Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Content="鼠标穿透（点击穿透浮窗）"
                                      VerticalAlignment="Center" Margin="16,8,0,0" IsChecked="{Binding Overlay.ClickThrough}" />
                        </Grid>

                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        <TextBlock Foreground="#444" Margin="0,2,0,0">
                            <Run Text="会话状态：" /><Run Text="{Binding SessionStateText}" />
                            <Run Text="   健康：" /><Run Text="{Binding HealthText}" />
                        </TextBlock>
                        <TextBlock Text="{Binding PreflightSummary}" Foreground="#666" TextWrapping="Wrap" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding MetricsText}" Foreground="#666" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

                        <Border Background="#F7F7F7" CornerRadius="4" Padding="8" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="会话存储（Milestone 4）" FontWeight="SemiBold" />
                                <TextBlock Margin="0,2,0,0" Foreground="#444">
                                    <Run Text="状态：" /><Run Text="{Binding StorageStatus}" />
                                    <Run Text="   已保存 final：" /><Run Text="{Binding SavedFinalCount}" />
                                    <Run Text="   最后保存：" /><Run Text="{Binding LastSavedText}" />
                                </TextBlock>
                                <TextBlock Foreground="#666" TextWrapping="Wrap" Margin="0,2,0,0">
                                    <Run Text="Session：" /><Run Text="{Binding StorageSessionId}" />
                                </TextBlock>
                                <TextBlock Text="{Binding StorageOutputDirectory}" Foreground="#666" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StorageError}" Foreground="#C62828" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Visibility="{Binding HasStorageError, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>

                        <Border Background="#F7F7F7" CornerRadius="4" Padding="8" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="录屏（Milestone 5）" FontWeight="SemiBold" />
                                <TextBlock Margin="0,2,0,0" Foreground="#444">
                                    <Run Text="状态：" /><Run Text="{Binding RecorderStatus}" />
                                    <Run Text="   编码器：" /><Run Text="{Binding RecordingEncoder}" />
                                </TextBlock>
                                <TextBlock Text="{Binding RecordingFilePath}" Foreground="#666" TextWrapping="Wrap" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding RecordingError}" Foreground="#C62828" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Visibility="{Binding HasRecordingError, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <!-- Milestone 6: company Azure OpenAI-compatible JA→ZH translation -->
                <GroupBox Header="日译中翻译（Milestone 6）" Margin="0,10,0,0" Padding="10"
                          DataContext="{Binding Translation}">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,8"
                                   Text="仅将日语 final 字幕文本发送到公司内部 OpenAI 兼容 API 翻译为中文。不发送音频、partial 或视频。API Key 以 Windows DPAPI 加密保存在本机，不写入配置或日志。" />
                        <CheckBox Content="启用日译中翻译" IsChecked="{Binding Enabled}" Margin="0,0,0,8" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Endpoint" VerticalAlignment="Center" Margin="0,2,8,2" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Model/Deployment" VerticalAlignment="Center" Margin="0,2,8,2" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="API Version" VerticalAlignment="Center" Margin="0,2,8,2" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ApiVersion, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="认证模式" VerticalAlignment="Center" Margin="0,2,8,2" />
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                <ComboBox Width="140" ItemsSource="{Binding AuthModes}" SelectedItem="{Binding AuthenticationMode}" />
                                <TextBlock Text="Header 名" VerticalAlignment="Center" Margin="12,0,6,0" />
                                <TextBox Width="140" Text="{Binding HeaderName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="API Key" VerticalAlignment="Center" Margin="0,2,8,2" />
                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                <PasswordBox x:Name="ApiKeyBox" Width="220" />
                                <Button Content="保存密钥" Click="SaveApiKey_Click" Padding="10,3" Margin="8,0,0,0" />
                                <Button Content="清除密钥" Command="{Binding ClearApiKeyCommand}" Padding="10,3" Margin="6,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="测试连接" Command="{Binding TestConnectionCommand}" Padding="12,4"
                                    IsEnabled="{Binding TestInProgress, Converter={StaticResource InverseBool}}" />
                            <TextBlock Text="{Binding KeyStatusText}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#444" />
                        </StackPanel>

                        <TextBlock Text="{Binding TestStatus}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#1565C0" />
                        <TextBlock Text="{Binding QueueStatus}" Margin="0,2,0,0" Foreground="#666" />
                        <TextBlock Text="{Binding LastErrorText}" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="#B26A00" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Milestone 3.1: full-meeting subtitle timeline (every final, first to last). -->
        <Border Grid.Column="1" Margin="12,0,0,0" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="6">
            <Grid DataContext="{Binding Realtime.Timeline}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header: full-meeting count + UI-only actions. -->
                <Grid Grid.Row="0" Margin="10,10,10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" FontSize="15">
                            <Run Text="会议字幕（全程 " /><Run Text="{Binding FinalCount, Mode=OneWay}" /><Run Text=" 条）" />
                        </TextBlock>
                        <TextBlock Text="最早在上、最新在下；上滑查看历史不会被打断。" Foreground="#888" FontSize="11" Margin="0,1,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="加载最近会话" Padding="8,3" Margin="6,0,0,0" FontSize="12"
                            Command="{Binding LoadMostRecentSessionCommand}"
                            IsEnabled="{Binding IsLoadingHistory, Converter={StaticResource InverseBool}}" />
                    <Button Grid.Column="2" Content="清空显示" Padding="8,3" Margin="6,0,0,0" FontSize="12"
                            Command="{Binding ClearDisplayCommand}" />
                </Grid>

                <!-- Virtualized timeline (recycling): thousands of finals scroll smoothly; the
                     virtualizer only recycles off-screen containers, it never drops data. -->
                <Grid Grid.Row="1">
                    <ListBox ItemsSource="{Binding Entries}"
                             behaviors:TimelineAutoScroll.ViewModel="{Binding}"
                             BorderThickness="0" Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,6" Margin="6,2,6,2" Background="#FAFAFA" CornerRadius="4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Time}" Foreground="#999" FontSize="11" />
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14" Margin="0,2,0,0" />
                                        <!-- Chinese translation filled in place (M6); no new card. -->
                                        <TextBlock Text="{Binding Translation}" TextWrapping="Wrap" FontSize="14"
                                                   Foreground="#1565C0" Margin="0,2,0,0"
                                                   Visibility="{Binding HasTranslation, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="翻译中…" FontSize="11" Foreground="#8A8A8A" Margin="0,2,0,0"
                                                   Visibility="{Binding IsTranslating, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="⚠ 翻译失败（已保留原文）" FontSize="11" Foreground="#B26A00" Margin="0,2,0,0"
                                                   Visibility="{Binding HasFailed, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- "有 N 条新字幕" hint: appears only when the user scrolled up. -->
                    <Button VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,10"
                            Padding="14,6" FontSize="12" Foreground="White" Background="#1565C0" BorderThickness="0"
                            Content="{Binding NewMessagesText}" Command="{Binding JumpToLatestCommand}"
                            Visibility="{Binding HasNewMessages, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <!-- Single bottom "recognizing" line (partial). Never enters the history above. -->
                <Border Grid.Row="2" Background="#FFF8E1" Padding="10,6" Margin="6,2,6,2" CornerRadius="4"
                        Visibility="{Binding HasPartial, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="#7A5A00">
                        <Run Text="正在识别：" /><Run Text="{Binding PartialText, Mode=OneWay}" />
                    </TextBlock>
                </Border>

                <TextBlock Grid.Row="3" Text="{Binding HistoryStatus}" Foreground="#666" FontSize="11"
                           TextWrapping="Wrap" Margin="10,4,10,8" />
            </Grid>
        </Border>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="重新检查环境" Padding="16,6" MinWidth="120"
                    Command="{Binding CheckEnvironmentCommand}"
                    IsEnabled="{Binding IsChecking, Converter={StaticResource InverseBool}}" />
        </StackPanel>
    </Grid>
</Window>
