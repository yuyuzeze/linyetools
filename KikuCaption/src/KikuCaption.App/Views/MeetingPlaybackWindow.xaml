<Window x:Class="KikuCaption.App.Views.MeetingPlaybackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:loc="clr-namespace:KikuCaption.App.Localization"
        Title="{loc:Loc Playback.Title}" Width="1180" Height="760" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Background="{StaticResource WindowBrush}">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="420" />
            <ColumnDefinition Width="2*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding TitleText, Mode=OneWay}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8" />
            <Border Grid.Row="1" Background="Black" CornerRadius="7" ClipToBounds="True">
                <vlc:VideoView x:Name="VideoView" />
            </Border>
            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <Slider x:Name="PositionSlider" Minimum="0" Maximum="{Binding DurationMilliseconds}"
                        Value="{Binding PositionMilliseconds, Mode=OneWay}" PreviewMouseLeftButtonUp="PositionSlider_MouseLeftButtonUp" />
                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PlayPauseButton" Content="{loc:Loc Playback.Play}" Style="{StaticResource PrimaryButton}"
                            MinWidth="86" Click="PlayPause_Click" />
                    <Button Grid.Column="1" Content="{loc:Loc Playback.Stop}" Margin="7,0,0,0" Click="Stop_Click" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Run Text="{Binding PositionText, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding DurationText, Mode=OneWay}" />
                    </TextBlock>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc Playback.Speed}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="RateBox" Width="78" SelectedIndex="1" SelectionChanged="RateBox_SelectionChanged">
                            <ComboBoxItem Content="0.75×" Tag="0.75" />
                            <ComboBoxItem Content="1.0×" Tag="1" />
                            <ComboBoxItem Content="1.25×" Tag="1.25" />
                            <ComboBoxItem Content="1.5×" Tag="1.5" />
                            <ComboBoxItem Content="2.0×" Tag="2" />
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>

        <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Background="White">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Margin="12,10,12,8">
                    <TextBlock Text="{loc:Loc Playback.Captions}" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Text="{loc:Loc Playback.CaptionHint}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                </StackPanel>
                <ListBox x:Name="CaptionList" Grid.Row="1" ItemsSource="{Binding Captions}" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Card" Padding="10,7" Margin="6,2" CornerRadius="6" Background="#F8F8F8"
                                    MouseLeftButtonUp="Caption_MouseLeftButtonUp" Cursor="Hand">
                                <StackPanel>
                                    <TextBlock Text="{Binding TimeText, Mode=OneWay}" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock Text="{Binding Text, Mode=OneWay}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding Translation, Mode=OneWay}" TextWrapping="Wrap" Margin="0,3,0,0"
                                               Foreground="{StaticResource AccentBrush}"
                                               Visibility="{Binding HasTranslation, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="Card" Property="Background" Value="{StaticResource NavSelectedBrush}" />
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="Card" Property="BorderThickness" Value="1" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Window>
