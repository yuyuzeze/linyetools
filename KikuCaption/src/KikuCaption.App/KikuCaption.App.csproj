<Project Sdk="Microsoft.NET.Sdk">

  <!-- WPF desktop entry point. Composes Core + Infrastructure via the Generic Host. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- UI-R5B: WinForms is enabled ONLY here (the WPF entry point) for System.Windows.Forms.NotifyIcon.
         It ships with the Windows Desktop SDK — no NuGet package, no third-party dependency. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>KikuCaption.App</RootNamespace>
    <AssemblyName>KikuCaption</AssemblyName>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- UseWindowsForms adds System.Windows.Forms/Drawing to the implicit global usings, which clash
       with the WPF equivalents (UserControl, ListBox, Application). Remove those implicit usings; the
       tray adapter references WinForms via an explicit alias instead. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KikuCaption.Core\KikuCaption.Core.csproj" />
    <ProjectReference Include="..\KikuCaption.Infrastructure\KikuCaption.Infrastructure.csproj" />
    <ProjectReference Include="..\KikuCaption.Audio\KikuCaption.Audio.csproj" />
    <ProjectReference Include="..\KikuCaption.Speech\KikuCaption.Speech.csproj" />
    <ProjectReference Include="..\KikuCaption.Storage\KikuCaption.Storage.csproj" />
    <ProjectReference Include="..\KikuCaption.Recording\KikuCaption.Recording.csproj" />
    <ProjectReference Include="..\KikuCaption.Translation\KikuCaption.Translation.csproj" />
    <ProjectReference Include="..\KikuCaption.Summarization\KikuCaption.Summarization.csproj" />
    <ProjectReference Include="..\KikuCaption.ComponentManagement\KikuCaption.ComponentManagement.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="LibVLCSharp.WPF" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- UI-R5B: the tray/app icon, packaged as a WPF Resource (loaded via pack URI, never a source path). -->
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

  <!-- Bundle the native speech.cpp engine (tools/speech) and its models (models/speech) into the
       output directory so the app resolves them by an EXE-RELATIVE path (no walk-up to the repo, no
       separate speech.cpp install). The binaries/models are git-ignored; these globs copy whatever
       is present and match nothing (no error) on a machine that has not placed them yet. -->
  <ItemGroup>
    <!-- speech.cpp is self-contained in exactly two files (engine exe + dll); copy them by name. -->
    <None Include="..\..\tools\speech\speech.exe;..\..\tools\speech\speech.dll">
      <Link>tools\speech\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
    <None Include="..\..\models\speech\**\*">
      <Link>models\speech\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

</Project>
