<Project Sdk="Microsoft.NET.Sdk">

  <!-- WPF desktop entry point. Composes Core + Infrastructure via the Generic Host. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- UI-R5B: WinForms is enabled ONLY here (the WPF entry point) for System.Windows.Forms.NotifyIcon.
         It ships with the Windows Desktop SDK — no NuGet package, no third-party dependency. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>KikuCaption.App</RootNamespace>
    <AssemblyName>KikuCaption</AssemblyName>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- UseWindowsForms adds System.Windows.Forms/Drawing to the implicit global usings, which clash
       with the WPF equivalents (UserControl, ListBox, Application). Remove those implicit usings; the
       tray adapter references WinForms via an explicit alias instead. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KikuCaption.Core\KikuCaption.Core.csproj" />
    <ProjectReference Include="..\KikuCaption.Infrastructure\KikuCaption.Infrastructure.csproj" />
    <ProjectReference Include="..\KikuCaption.Audio\KikuCaption.Audio.csproj" />
    <ProjectReference Include="..\KikuCaption.Speech\KikuCaption.Speech.csproj" />
    <ProjectReference Include="..\KikuCaption.Storage\KikuCaption.Storage.csproj" />
    <ProjectReference Include="..\KikuCaption.Recording\KikuCaption.Recording.csproj" />
    <ProjectReference Include="..\KikuCaption.Translation\KikuCaption.Translation.csproj" />
    <ProjectReference Include="..\KikuCaption.Summarization\KikuCaption.Summarization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- UI-R5B: the tray/app icon, packaged as a WPF Resource (loaded via pack URI, never a source path). -->
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

</Project>
