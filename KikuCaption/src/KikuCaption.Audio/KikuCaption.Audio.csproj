<Project Sdk="Microsoft.NET.Sdk">

  <!--
    System audio capture (NAudio WASAPI loopback) and format conversion.
    Targets net10.0-windows because WASAPI is Windows-only, but does NOT enable WPF /
    WinForms: the audio module must not depend on any UI framework (PROJECT.md M1 约束).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>KikuCaption.Audio</RootNamespace>
    <UseWPF>false</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KikuCaption.Core\KikuCaption.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
