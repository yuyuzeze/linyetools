<Project Sdk="Microsoft.NET.Sdk">

  <!--
    FFmpeg-based screen/window recording with system audio via a named pipe. Manages FFmpeg as a
    subprocess (structured ArgumentList, never a shell). net10.0-windows for user32 window
    enumeration and named-pipe ACLs; no WPF dependency.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>KikuCaption.Recording</RootNamespace>
    <UseWPF>false</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KikuCaption.Core\KikuCaption.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
