<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Persistence: SQLite session/segment store, file exporters (JSON/TXT/SRT/session.json),
    real-time persistence pipeline and crash recovery. Depends on Core only; no WPF.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>KikuCaption.Storage</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KikuCaption.Core\KikuCaption.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- Direct reference pins the patched native SQLite lib (3.x) over the transitive 2.1.x. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
