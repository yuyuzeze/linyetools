<Project Sdk="Microsoft.NET.Sdk">

  <!--
    C# side of the resident Python Whisper worker: JSON Lines protocol, child-process
    lifecycle (with a Windows Job Object to avoid orphan processes) and ISpeechRecognizer.
    net10.0-windows (Job Object P/Invoke); no WPF dependency.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>KikuCaption.Speech</RootNamespace>
    <UseWPF>false</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KikuCaption.Core\KikuCaption.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
