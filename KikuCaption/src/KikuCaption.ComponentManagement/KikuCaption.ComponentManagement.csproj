<Project Sdk="Microsoft.NET.Sdk">

  <!--
    R7A: unified remote-resource infrastructure (manifest, version comparison, secure download +
    safe unzip). Pure net10.0 library, no WPF. Depends on Core only; uses only built-in
    System.Net.Http / System.Text.Json / System.IO.Compression / System.Security.Cryptography.
    This stage builds the plumbing ONLY — it does not install models, update the app, or create a
    venv, and it is not yet wired into any UI (that arrives in R7B+).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>KikuCaption.ComponentManagement</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KikuCaption.Core\KikuCaption.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- R7A.2: the DI extension registers a typed HttpClient whose primary handler has
         AllowAutoRedirect=false, so redirect-off is guaranteed structurally, not by the caller. -->
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- The redirect-free transport wrapper is internal; tests construct it over a fake handler. -->
    <InternalsVisibleTo Include="KikuCaption.ComponentManagement.Tests" />
  </ItemGroup>

</Project>
