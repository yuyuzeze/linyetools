{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linye.local/excelspec/schemas/template/1.0",
  "title": "ExcelSpec Template",
  "type": "object",
  "additionalProperties": false,
  "required": ["template_id", "version", "name", "sheets", "schema_version"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "template_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "match": { "$ref": "#/$defs/templateMatch" },
    "sheets": {
      "type": "array",
      "items": { "$ref": "#/$defs/sheetTemplate" }
    },
    "validation_rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/validationRule" },
      "default": []
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "default": {}
    }
  },
  "$defs": {
    "fingerprintRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sheet_name_pattern": { "type": "string", "minLength": 1 },
        "cells": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Z]+[1-9][0-9]*$" },
          "additionalProperties": { "type": "string" },
          "default": {}
        },
        "required_text": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "weight": { "type": "number", "exclusiveMinimum": 0, "default": 1 }
      },
      "anyOf": [
        {
          "required": ["cells"],
          "properties": { "cells": { "minProperties": 1 } }
        },
        {
          "required": ["required_text"],
          "properties": { "required_text": { "minItems": 1 } }
        }
      ]
    },
    "templateMatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sheet_name_patterns": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "fingerprints": {
          "type": "array",
          "items": { "$ref": "#/$defs/fingerprintRule" },
          "default": []
        },
        "minimum_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.7
        },
        "file_name_patterns": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "require_file_name_match": {
          "type": "boolean",
          "default": false
        },
        "file_name_priority": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "regionLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["fixed", "anchor"] },
        "range": { "type": "string", "pattern": "^[A-Z]+[1-9][0-9]*:[A-Z]+[1-9][0-9]*$" },
        "anchor_text": { "type": "string", "minLength": 1 },
        "anchor_pattern": { "type": "string", "minLength": 1 },
        "end_anchor_text": { "type": "string", "minLength": 1 },
        "end_anchor_pattern": { "type": "string", "minLength": 1 },
        "row_offset": { "type": "integer", "default": 0 },
        "column_offset": { "type": "integer", "default": 0 },
        "height": { "type": "integer", "minimum": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "repeat_anchor": {
          "type": "boolean",
          "default": false,
          "description": "Find every matching anchor and extract one region per match."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "fixed" } } },
          "then": { "required": ["range"] }
        },
        {
          "if": { "properties": { "mode": { "const": "anchor" } } },
          "then": {
            "anyOf": [
              { "required": ["anchor_text"] },
              { "required": ["anchor_pattern"] }
            ]
          }
        }
      ]
    },
    "extractionSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["table", "key_value", "freeform", "asset"] },
        "header_rows": { "type": "integer", "minimum": 0, "default": 0 },
        "key_column": { "type": "integer", "minimum": 1 },
        "value_column": { "type": "integer", "minimum": 1 },
        "key_semantics": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "default": {}
        },
        "column_semantics": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "default": {}
        },
        "options": {
          "type": "object",
          "additionalProperties": true,
          "default": {}
        }
      }
    },
    "screenshotBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "path"],
      "properties": {
        "asset_id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "asset_type": { "enum": ["screenshot", "image", "chart", "layout"], "default": "screenshot" },
        "description": { "type": "string" }
      }
    },
    "validationRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "kind"],
      "properties": {
        "rule_id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["required", "regex", "enum", "unique", "reference"] },
        "severity": { "enum": ["info", "warning", "error"], "default": "error" },
        "field": { "type": "string" },
        "message": { "type": "string" },
        "options": {
          "type": "object",
          "additionalProperties": true,
          "default": {}
        }
      }
    },
    "regionTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region_id", "region_type", "locator"],
      "properties": {
        "region_id": { "type": "string", "minLength": 1 },
        "region_type": {
          "enum": ["metadata", "key_value", "table", "freeform", "image", "chart", "layout"]
        },
        "title": { "type": "string" },
        "locator": { "$ref": "#/$defs/regionLocator" },
        "extractor": { "$ref": "#/$defs/extractionSpec" },
        "screenshot_bindings": {
          "type": "array",
          "items": { "$ref": "#/$defs/screenshotBinding" },
          "default": []
        },
        "validation_rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/validationRule" },
          "default": []
        },
        "order": { "type": "integer", "minimum": 0, "default": 0 },
        "required": { "type": "boolean", "default": false }
      }
    },
    "sheetTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sheet_id", "name_pattern"],
      "properties": {
        "sheet_id": { "type": "string", "minLength": 1 },
        "name_pattern": { "type": "string", "minLength": 1 },
        "regions": {
          "type": "array",
          "items": { "$ref": "#/$defs/regionTemplate" },
          "default": []
        },
        "required": { "type": "boolean", "default": true },
        "order": { "type": "integer", "minimum": 0, "default": 0 }
      }
    }
  }
}
